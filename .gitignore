# --- Zsh State & Caches ---
zsh/.config/zsh/.zhistory
zsh/.config/zsh/.zcompdump*
zsh/.config/zsh/.zcompcache/
zsh/.config/zsh/.zsh_sessions/

# Machine-specific and private
zsh/.config/zsh/host.zsh

# Zed local state
zed/.config/zed/prompts/
zed/.config/zed/themes/

# Claude Code per-directory permissions
**/.claude/settings.local.json

# Global Claude module: allowlist shareable items only
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json
!claude/.claude/skills/
!claude/.claude/skills/**

# mkdocs build output
site/

# System junk
.DS_Store
.AppleDouble
.LSOverride
.venv-docs/
